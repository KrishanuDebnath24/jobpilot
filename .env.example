# ============================================================
# JobPilot — environment template. Copy to `.env` and fill in.
# NEVER commit the real `.env` (it is gitignored).
# ============================================================

# --- Postgres (docker-compose service: db) ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_dev_pw
POSTGRES_DB=jobpilot
# Full URL the backend uses. Host is `db` inside docker, `localhost` from host.
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_dev_pw@db:5432/jobpilot

# --- Redis (docker-compose service: redis) ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
# Generate a strong secret, e.g.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- Phase 0 seeded test user (in-memory until Phase 1 adds the users table) ---
TEST_USER_EMAIL=test@jobpilot.dev
TEST_USER_PASSWORD=changeme123

# --- CORS: frontend origin allowed to call the API ---
FRONTEND_ORIGIN=http://localhost:3000

# --- Frontend → backend base URL (used by Next.js) ---
# Inside docker the browser still hits localhost; keep this as the public URL.
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Anthropic (unused in Phase 0; wired up when agents land in Phase 2+) ---
ANTHROPIC_API_KEY=

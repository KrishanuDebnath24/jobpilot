# ============================================================
# JobPilot — environment template. Copy to `.env` and fill in.
# NEVER commit the real `.env` (it is gitignored). Several services make LLM calls
# (Scout crawl extraction, Qualifier, Analyzer/Enhancer, Concierge, Query agent), so a
# real ANTHROPIC_API_KEY is REQUIRED for those — set a low Console spend cap first.
#
# Hostnames below are the docker-compose service names (db, redis, minio).
# To run processes on the host against the dockerized infra, use `localhost`.
# ============================================================

# --- Postgres (service: db) ---
POSTGRES_USER=jobpilot
POSTGRES_PASSWORD=jobpilot_dev_pw
POSTGRES_DB=jobpilot
# Async driver (asyncpg). host=db in compose, localhost from the host.
DATABASE_URL=postgresql+asyncpg://jobpilot:jobpilot_dev_pw@db:5432/jobpilot

# --- Redis (service: redis) ---
REDIS_URL=redis://redis:6379/0

# --- Auth / JWT ---
# Generate a strong secret:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# --- MCP request-context signing (backend -> MCP service tokens) ---
# Leave empty to reuse JWT_SECRET. The MCP services derive user_id ONLY from
# this signed token, never from tool arguments.
MCP_SHARED_SECRET=
MCP_CONTEXT_TTL_SECONDS=120

# --- MCP service endpoints (used by the backend MCP clients) ---
DB_MCP_URL=http://db-mcp:8001/mcp
RESUME_MCP_URL=http://resume-mcp:8002/mcp
CONFIG_MCP_URL=http://config-mcp:8003/mcp
SOURCES_MCP_URL=http://sources-mcp:8004/mcp

# --- Storage (S3 / MinIO, service: minio) ---
STORAGE_BACKEND=s3
STORAGE_BUCKET=jobpilot-resumes
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1
# Used only when STORAGE_BACKEND=local:
STORAGE_LOCAL_DIR=./.storage

# --- Resume upload guardrails / GDPR retention ---
RESUME_MAX_BYTES=10485760
RESUME_RETENTION_DAYS=365

# --- Embeddings (Phase 7: semantic search). The Phase-1 pgvector columns are populated
#     here — async (backfill once + embed-on-write), never blocking a write. Default
#     backend is LOCAL sentence-transformers (zero API cost; the price is a heavy `torch`
#     dep, in the backend/worker image only — the MCP services never embed). The hosted
#     Voyage alternative was evaluated and NOT chosen (see DECISIONS.md). Native model
#     vectors are zero-padded to EMBEDDING_DIM (the fixed column width). Set
#     EMBEDDING_BACKEND=hashing for a dependency-free offline/test fallback. ---
EMBEDDING_DIM=1024
EMBEDDING_BACKEND=sentence_transformers                   # sentence_transformers | hashing
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2    # 384-dim, ~80MB, padded to EMBEDDING_DIM
EMBEDDING_BATCH_SIZE=64
EMBEDDING_MAX_CHARS=4000

# --- Seeded test user (created by scripts.seed_user) ---
TEST_USER_EMAIL=test@jobpilot.dev
TEST_USER_PASSWORD=changeme123

# --- CORS / frontend ---
FRONTEND_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Anthropic (Phase 2+). REQUIRED for services that make LLM calls
#     (sources-mcp crawl extraction). Set a low spend cap (~$10/mo) in the
#     Console first. Backend/sources-mcp env only — never the frontend, never git. ---
ANTHROPIC_API_KEY=
# Per-agent model config (a value, not a constant). Scout uses the cheap tier.
SCOUT_EXTRACTOR_MODEL=claude-haiku-4-5-20251001
LLM_MAX_OUTPUT_TOKENS=1024

# --- Adzuna developer API (free tier). developer.adzuna.com. Backend/sources-mcp
#     env only. NOTE: Adzuna has no Republic-of-Ireland ("ie") coverage; "gb"
#     covers Northern Ireland (Belfast). RoI (Dublin) comes from Greenhouse+crawler. ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRY=gb
ADZUNA_RESULTS_PER_PAGE=50
ADZUNA_MAX_LOCATIONS=3

# --- Crawler politeness + spend guards (single Irish board, robots-respecting) ---
CRAWLER_MAX_PAGES=3
CRAWLER_MIN_DELAY_SECONDS=2.0
CRAWLER_TIMEOUT_SECONDS=20.0

# --- Phase 5 (Analyzer + Enhancer). Two-model split, config-driven. Analyzer =
#     high-volume extraction (Haiku, batched + prompt-cached); Enhancer = user-facing
#     reasoning (Sonnet; falls back to the Analyzer model if unavailable). ---
ANALYZER_MODEL=claude-haiku-4-5-20251001
ENHANCER_MODEL=claude-sonnet-5
ANALYZE_MAX_JOBS=200
ANALYZE_BATCH_THRESHOLD=8      # >= this many jobs -> Batch API (50% off); else sync+cached
ANALYZE_MAX_DESC_CHARS=6000
BATCH_POLL_INTERVAL_SECONDS=10.0
BATCH_MAX_WAIT_SECONDS=1800
# Append Analyze→Enhance to the autonomous Scout→Qualify pipeline? OFF by default —
# analyzing every scheduled scout is expensive and presumptuous.
ANALYZE_IN_PIPELINE=false

# --- Phase 6 (Concierge). A Sonnet tier for reasoning/routing/judgment over a scoped
#     toolset; interactive (no batch); stable system prompt + tool defs are cached. ---
CONCIERGE_MODEL=claude-sonnet-5
CONCIERGE_MAX_TOKENS=2048
CONCIERGE_MAX_TOOL_ITERATIONS=8

# --- Phase 7 (Query agent). READ-ONLY Q&A over the user's data + work status: routes
#     each question to structured (exact counts/aggregates incl. tailored-CV before/after
#     score deltas), semantic (pgvector), or live status. Haiku by default (routing +
#     synthesis is mechanical); interactive (no batch); system prompt + tool defs cached.
#     Promote to a Sonnet tier only if synthesis quality warrants. ---
QUERY_MODEL=claude-haiku-4-5
QUERY_MAX_TOKENS=1024
QUERY_MAX_TOOL_ITERATIONS=6
QUERY_SEMANTIC_LIMIT=8            # rows returned by a semantic similarity search

# --- Phase 8 (observability). OpenTelemetry, LOCAL by default. Traces span agent runs,
#     pipeline stages, MCP tool calls, and LLM calls (model + token/cache/batch counts +
#     est. cost + latency), correlated by user/pipeline_id. NO PII on spans/logs — ids,
#     counts, model, cost only. Set OTEL_EXPORTER_OTLP_ENDPOINT to ship to a collector you
#     run; else set TRACING_CONSOLE_EXPORT=true for stdout, else spans are created but not
#     exported. The MCP service images don't install OTel, so tracing no-ops there. ---
TRACING_ENABLED=true
TRACING_CONSOLE_EXPORT=false
OTEL_EXPORTER_OTLP_ENDPOINT=      # e.g. http://otel-collector:4318/v1/traces
COST_ALERT_DAILY_USD=5.0          # soft per-user LLM spend alert threshold (USD/day)

# --- Phase 8c (rate limiting / abuse protection). Per-user fixed-window limits over Redis
#     on the expensive/triggering endpoints; login is per-IP (brute-force guard). Fail-open
#     (a Redis outage never locks users out). Complements the one-active-pipeline DB guard. ---
RATE_LIMIT_ENABLED=true
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_TRIGGER_PER_MIN=10     # scout/qualify/analyze/enhance/pipeline/cv.*/embeddings
RATE_LIMIT_CHAT_PER_MIN=20        # query/ask + concierge chat (interactive LLM)
RATE_LIMIT_AUTH_PER_MIN=10        # login attempts per IP

# --- Aggregator connectors for Republic-of-Ireland coverage. Backend/sources-mcp
#     env only. Jooble + Careerjet are free (on by default); JSearch is RapidAPI-
#     metered (off by default, page-capped — confirm your quota before enabling). ---
JOOBLE_API_KEY=
CAREERJET_API_KEY=
CAREERJET_LOCALE=en_IE
CAREERJET_USER_IP=127.0.0.1
# JSearch (Google-for-Jobs). Prefer OpenWeb Ninja (api.openwebninja.com, X-API-Key);
# RAPIDAPI_KEY is a fallback. NOTE: Google-for-Jobs has no RoI coverage today (ie -> 0
# results); it's kept for other markets. Still off by default in sources[].
JSEARCH_API_KEY=
RAPIDAPI_KEY=
JSEARCH_COUNTRY=ie
JSEARCH_MAX_PAGES=1
